@app.route('/apriori')
def apriori_analysis():
    active_dataset = get_active_dataset()
    if not active_dataset:
        flash(
            'Belum ada data yang siap dianalisis. '
            'Silakan upload data e-commerce dan lakukan proses cleaning terlebih dahulu.',
            'warning'
        )
        return redirect(url_for('upload_data'))

    session_ids = get_dataset_session_ids(active_dataset['id'])
    if not session_ids:
        flash('Belum ada data cleaned dalam dataset aktif.', 'warning')
        return redirect(url_for('upload_data'))

    conn = get_db_connection()
    placeholders, params = build_session_in_clause(session_ids)

    # Ambil seluruh transaksi dari semua session dalam dataset aktif
    df = pd.read_sql_query(
        f'SELECT id_transaksi, produk, jumlah FROM cleaned_transaksi WHERE session_id IN ({placeholders})',
        conn,
        params=params
    )

    # Agregasi stats untuk info tampilan
    stat_rows = conn.execute(
        f'SELECT * FROM cleaning_stats WHERE session_id IN ({placeholders})', params
    ).fetchall()
    active = conn.execute(
        "SELECT * FROM upload_session WHERE id=?", (session_ids[-1],)
    ).fetchone()
    conn.close()

    stats = None
    if stat_rows:
        stats = {
            'total_raw': sum(safe_int(r['total_raw']) for r in stat_rows),
            'total_clean': sum(safe_int(r['total_clean']) for r in stat_rows),
            'total_batal': sum(safe_int(r['total_batal']) for r in stat_rows),
            'total_invalid': sum(safe_int(r['total_invalid']) for r in stat_rows),
        }

    if df.empty:
        flash('Data cleaned masih kosong.', 'warning')
        return redirect(url_for('cleaned_data'))

    min_support = request.args.get('min_support', 0.005, type=float)
    min_confidence = request.args.get('min_confidence', 0.5, type=float)

    frequent_itemsets, rules, apriori_stats = perform_apriori(
        df, min_support=min_support, min_threshold=min_confidence, return_stats=True
    )

    frequent_data = []
    if frequent_itemsets is not None:
        frequent_data = frequent_itemsets.to_dict('records')
        for item in frequent_data:
            item_list = list(item['itemsets'])
            item['itemsets'] = ', '.join(item_list)
            item['n_items'] = len(item_list)

    rules_data = []
    if rules is not None and not rules.empty:
        rules_data = rules.to_dict('records')
        for rule in rules_data:
            rule['antecedents'] = ', '.join(list(rule['antecedents']))
            rule['consequents'] = ', '.join(list(rule['consequents']))

    return render_template('apriori.html',
                           frequent_itemsets=frequent_data,
                           rules=rules_data,
                           apriori_stats=apriori_stats,
                           min_support=min_support,
                           min_confidence=min_confidence,
                           active_session=active,
                           active_dataset=active_dataset,
                           data_stats=stats)


@app.route('/rekomendasi')
def rekomendasi_restok():
    """
    Integrasi Model Penelitian Skripsi:
    Pencegahan Stockout Menggunakan Moving Average Sebagai Pemicu Algoritma Apriori pada Sistem Rekomendasi Restok
    """
    active_dataset = get_active_dataset()
    if not active_dataset:
        flash(
            'Belum ada data yang siap dianalisis. '
            'Silakan upload data e-commerce dan lakukan proses cleaning terlebih dahulu.',
            'warning'
        )
        return redirect(url_for('upload_data'))

    session_ids = get_dataset_session_ids(active_dataset['id'])
    if not session_ids:
        flash('Belum ada data cleaned dalam dataset aktif.', 'warning')
        return redirect(url_for('upload_data'))

    conn = get_db_connection()
    placeholders, params = build_session_in_clause(session_ids)

    df = pd.read_sql_query(
        f'SELECT id_transaksi, tanggal, produk, jumlah FROM cleaned_transaksi WHERE session_id IN ({placeholders})',
        conn,
        params=params
    )

    stat_rows = conn.execute(
        f'SELECT * FROM cleaning_stats WHERE session_id IN ({placeholders})', params
    ).fetchall()
    active = conn.execute(
        "SELECT * FROM upload_session WHERE id=?", (session_ids[-1],)
    ).fetchone()
    conn.close()

    stats = None
    if stat_rows:
        stats = {
            'total_raw': sum(safe_int(r['total_raw']) for r in stat_rows),
            'total_clean': sum(safe_int(r['total_clean']) for r in stat_rows),
            'total_batal': sum(safe_int(r['total_batal']) for r in stat_rows),
            'total_invalid': sum(safe_int(r['total_invalid']) for r in stat_rows),
        }

    if df.empty:
        flash('Data cleaned masih kosong.', 'warning')
        return redirect(url_for('cleaned_data'))

    window = request.args.get('window', 12, type=int)
    min_support = request.args.get('min_support', 0.005, type=float)
    min_confidence = request.args.get('min_confidence', 0.5, type=float)

    rec_data = get_restock_recommendations(
        df, window=window, min_support=min_support, min_confidence=min_confidence
    )

    return render_template('rekomendasi.html',
                           rec_data=rec_data,
                           window=window,
                           min_support=min_support,
                           min_confidence=min_confidence,
                           active_session=active,
                           active_dataset=active_dataset,
                           data_stats=stats)


@app.route('/moving_average')
def moving_average_analysis():
    active_dataset = get_active_dataset()
    if not active_dataset:
        flash(
            'Belum ada data yang siap dianalisis. '
            'Silakan upload data e-commerce dan lakukan proses cleaning terlebih dahulu.',
            'warning'
        )
        return redirect(url_for('upload_data'))

    session_ids = get_dataset_session_ids(active_dataset['id'])
    if not session_ids:
        flash('Belum ada data cleaned dalam dataset aktif.', 'warning')
        return redirect(url_for('upload_data'))

    conn = get_db_connection()
    placeholders, params = build_session_in_clause(session_ids)

    # Ambil seluruh transaksi dari semua session dalam dataset aktif
    df = pd.read_sql_query(
        f'SELECT tanggal, produk, jumlah FROM cleaned_transaksi WHERE session_id IN ({placeholders})',
        conn,
        params=params
    )

    # Agregasi stats untuk info tampilan
    stat_rows = conn.execute(
        f'SELECT * FROM cleaning_stats WHERE session_id IN ({placeholders})', params
    ).fetchall()
    active = conn.execute(
        "SELECT * FROM upload_session WHERE id=?", (session_ids[-1],)
    ).fetchone()
    conn.close()

    stats = None
    if stat_rows:
        stats = {
            'total_raw': sum(safe_int(r['total_raw']) for r in stat_rows),
            'total_clean': sum(safe_int(r['total_clean']) for r in stat_rows),
            'total_batal': sum(safe_int(r['total_batal']) for r in stat_rows),
            'total_invalid': sum(safe_int(r['total_invalid']) for r in stat_rows),
        }

    if df.empty:
        flash('Data cleaned masih kosong.', 'warning')
        return redirect(url_for('cleaned_data'))

    window = request.args.get('window', 12, type=int)
    ma_data = calculate_moving_average(df, window=window)
    
    # Handle both old (list) and new (dict) return types defensively
    results = ma_data['items'] if isinstance(ma_data, dict) else ma_data
    validation = ma_data.get('validation') if isinstance(ma_data, dict) else None

    return render_template('moving_average.html',
                           results=results,
                           validation=validation,
                           window=window,
                           active_session=active,
                           active_dataset=active_dataset,
                           data_stats=stats)


# ─────────────────────────────────────────────
# ROUTES — EXPORT PDF
# ─────────────────────────────────────────────

@app.route('/export_pdf')
def export_pdf():
    conn = get_db_connection()
    active_dataset = get_active_dataset()
    stats = None

    if active_dataset:
        session_ids = get_dataset_session_ids(active_dataset['id'])
        if session_ids:
            placeholders, params = build_session_in_clause(session_ids)
            df = pd.read_sql_query(
                f'SELECT id_transaksi, tanggal, produk, jumlah FROM cleaned_transaksi WHERE session_id IN ({placeholders}) ORDER BY tanggal DESC',
                conn,
                params=params
            )
            stat_rows = conn.execute(
                f'SELECT * FROM cleaning_stats WHERE session_id IN ({placeholders})', params
            ).fetchall()
            if stat_rows:
                stats = {
                    'total_raw': sum(safe_int(r['total_raw']) for r in stat_rows),
                    'total_clean': sum(safe_int(r['total_clean']) for r in stat_rows),
                    'total_batal': sum(safe_int(r['total_batal']) for r in stat_rows),
                    'total_invalid': sum(safe_int(r['total_invalid']) for r in stat_rows),
                }
        else:
            df = pd.DataFrame()
    else:
        df = pd.read_sql_query('SELECT * FROM transaksi ORDER BY tanggal DESC', conn)

    conn.close()

    if df.empty:
        flash('Data kosong, tidak bisa membuat laporan.', 'warning')
        return redirect(url_for('index'))

    buffer = io.BytesIO()
    doc = SimpleDocTemplate(
        buffer,
        pagesize=letter,
        leftMargin=36,
        rightMargin=36,
        topMargin=36,
        bottomMargin=36
    )
    styles = getSampleStyleSheet()
    prod_style = ParagraphStyle('ProdStyle', parent=styles['Normal'], fontSize=8, leading=10)
    elements = []

    elements.append(Paragraph("Laporan Analisis Stok Marema Textile", styles['Title']))
    elements.append(Spacer(1, 12))

    if stats:
        elements.append(Paragraph("Statistik Data Cleaning", styles['Heading2']))
        elements.append(Paragraph(f"Total Data Mentah: {stats['total_raw']:,}", styles['Normal']))
        elements.append(Paragraph(f"Data Setelah Cleaning: {stats['total_clean']:,}", styles['Normal']))
        elements.append(Paragraph(f"Data Dibatalkan (Status Batal): {stats['total_batal']:,}", styles['Normal']))
        elements.append(Paragraph(f"Data Tidak Valid: {stats['total_invalid']:,}", styles['Normal']))
        elements.append(Spacer(1, 12))

    elements.append(Paragraph("Sampel Data Transaksi (20 Baris Terakhir)", styles['Heading2']))
    data = [['ID Transaksi', 'Tanggal', 'Produk', 'Jumlah']]
    for _, row in df.head(20).iterrows():
        p_cell = Paragraph(str(row['produk']), prod_style)
        data.append([str(row['id_transaksi']), str(row['tanggal']), p_cell, str(row['jumlah'])])

    t = Table(data, colWidths=[110, 75, 305, 50])
    t.setStyle(TableStyle([
        ('BACKGROUND', (0, 0), (-1, 0), colors.HexColor('#1e3a5f')),
        ('TEXTCOLOR', (0, 0), (-1, 0), colors.whitesmoke),
        ('ALIGN', (0, 0), (-1, 0), 'CENTER'),
        ('ALIGN', (0, 1), (1, -1), 'CENTER'),
        ('ALIGN', (2, 1), (2, -1), 'LEFT'),
        ('ALIGN', (3, 1), (3, -1), 'CENTER'),
        ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
        ('FONTSIZE', (0, 0), (-1, 0), 9),
        ('FONTSIZE', (0, 1), (-1, -1), 8),
        ('BOTTOMPADDING', (0, 0), (-1, 0), 6),
        ('TOPPADDING', (0, 0), (-1, 0), 6),
        ('GRID', (0, 0), (-1, -1), 0.5, colors.HexColor('#cbd5e1')),
        ('VALIGN', (0, 0), (-1, -1), 'MIDDLE'),
    ]))
    elements.append(t)
    elements.append(Spacer(1, 18))

    elements.append(Paragraph("Ringkasan Keseluruhan", styles['Heading2']))
    elements.append(Paragraph(f"Total Transaksi Valid: {len(df):,}", styles['Normal']))
    elements.append(Paragraph(f"Total Jenis Produk: {df['produk'].nunique()}", styles['Normal']))

    doc.build(elements)
    buffer.seek(0)

    from flask import make_response
    response = make_response(buffer.getvalue())
    response.headers['Content-Type'] = 'application/pdf'
    response.headers['Content-Disposition'] = 'attachment; filename="laporan_marema.pdf"'
    return response


if __name__ == '__main__':
    app.run(debug=True)
