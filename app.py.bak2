# ─── Custom Jinja2 Filters ───
@app.template_filter('format_number')
def format_number(value):
    """Format angka dengan pemisah ribuan."""
    try:
        return f"{int(value):,}".replace(",", ".")
    except (ValueError, TypeError):
        return value

def safe_int(val):
    if val is None:
        return 0
    if isinstance(val, bytes):
        return int.from_bytes(val, 'little')
    return int(val)

# ─────────────────────────────────────────────
# DATABASE SETUP
# ─────────────────────────────────────────────

def get_db_connection():
    conn = sqlite3.connect(DATABASE)
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    conn = get_db_connection()

    # Tabel lama (input manual) — dipertahankan
    conn.execute('''
        CREATE TABLE IF NOT EXISTS transaksi (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            id_transaksi TEXT NOT NULL,
            tanggal DATE NOT NULL,
            produk TEXT NOT NULL,
            jumlah INTEGER NOT NULL
        )
    ''')

    # Dataset: pengelompokan beberapa upload_session menjadi satu dataset penelitian
    conn.execute('''
        CREATE TABLE IF NOT EXISTS dataset (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nama TEXT NOT NULL,
            status TEXT DEFAULT 'aktif',
            dibuat TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')

    # Tabel baru: menyimpan info sesi upload raw terakhir
    conn.execute('''
        CREATE TABLE IF NOT EXISTS upload_session (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            filename TEXT NOT NULL,
            upload_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            total_rows INTEGER DEFAULT 0,
            column_mapping TEXT,
            raw_preview TEXT,
            status TEXT DEFAULT 'pending'
        )
    ''')

    # Tambah kolom dataset_id ke upload_session jika belum ada (non-destructive)
    try:
        conn.execute('ALTER TABLE upload_session ADD COLUMN dataset_id INTEGER REFERENCES dataset(id)')
    except Exception:
        pass  # Kolom sudah ada

    # Tabel baru: data hasil cleaning (sumber utama analisis)
    conn.execute('''
        CREATE TABLE IF NOT EXISTS cleaned_transaksi (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id INTEGER NOT NULL,
            id_transaksi TEXT NOT NULL,
            tanggal DATE NOT NULL,
            produk TEXT NOT NULL,
            jumlah INTEGER NOT NULL,
            FOREIGN KEY(session_id) REFERENCES upload_session(id)
        )
    ''')

    # Tabel baru: statistik cleaning per sesi
    conn.execute('''
        CREATE TABLE IF NOT EXISTS cleaning_stats (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id INTEGER NOT NULL UNIQUE,
            total_raw INTEGER DEFAULT 0,
            total_clean INTEGER DEFAULT 0,
            total_batal INTEGER DEFAULT 0,
            total_invalid INTEGER DEFAULT 0,
            cleaning_reasons TEXT,
            has_status_col INTEGER DEFAULT 0,
            pct_valid REAL DEFAULT 0,
            FOREIGN KEY(session_id) REFERENCES upload_session(id)
        )
    ''')

    conn.commit()
    conn.close()


init_db()


# ─────────────────────────────────────────────
# HELPER: dataset dan session
# ─────────────────────────────────────────────

def get_active_dataset():
    """Kembalikan dataset aktif (status='aktif') yang paling baru."""
    conn = get_db_connection()
    row = conn.execute(
        "SELECT * FROM dataset WHERE status='aktif' ORDER BY id DESC LIMIT 1"
    ).fetchone()
    conn.close()
    return row


def get_dataset_session_ids(dataset_id):
    """Kembalikan list session_id yang tergabung dalam suatu dataset dan sudah cleaned."""
    conn = get_db_connection()
    rows = conn.execute(
        "SELECT id FROM upload_session WHERE dataset_id=? AND status='cleaned' ORDER BY id ASC",
        (dataset_id,)
    ).fetchall()
    conn.close()
    return [r['id'] for r in rows]


def get_or_create_active_dataset(conn):
    """Ambil dataset aktif. Jika belum ada, buat dataset baru secara otomatis."""
    row = conn.execute(
        "SELECT * FROM dataset WHERE status='aktif' ORDER BY id DESC LIMIT 1"
    ).fetchone()
    if row:
        return row['id']
    cur = conn.execute(
        "INSERT INTO dataset (nama, status) VALUES (?, 'aktif')",
        ('Dataset Penelitian',)
    )
    return cur.lastrowid


def get_active_session():
    """Kembalikan sesi upload terbaru yang sudah cleaned (untuk backward compat)."""
    conn = get_db_connection()
    row = conn.execute(
        "SELECT * FROM upload_session WHERE status='cleaned' ORDER BY id DESC LIMIT 1"
    ).fetchone()
    conn.close()
    return row


def get_latest_session_any():
    """Kembalikan sesi upload terakhir apapun statusnya."""
    conn = get_db_connection()
    row = conn.execute(
        "SELECT * FROM upload_session ORDER BY id DESC LIMIT 1"
    ).fetchone()
    conn.close()
    return row


def get_cleaning_stats_for_session(session_id):
    conn = get_db_connection()
    row = conn.execute(
        "SELECT * FROM cleaning_stats WHERE session_id = ?", (session_id,)
    ).fetchone()
    conn.close()
    return row


def build_session_in_clause(session_ids):
    """Buat SQL IN clause dan params tuple dari list session_ids."""
    if not session_ids:
        return 'SELECT id FROM upload_session WHERE 1=0', ()
    placeholders = ','.join('?' * len(session_ids))
    return placeholders, tuple(session_ids)


# ─────────────────────────────────────────────
# ROUTES — DASHBOARD
# ─────────────────────────────────────────────

@app.route('/')
def index():
    conn = get_db_connection()

    # Statistik dari dataset aktif (gabungan semua session dalam dataset)
    active_dataset = get_active_dataset()
    total_clean = 0
    total_produk_clean = 0
    labels = []
    values = []
    active = None  # untuk template (gunakan session terbaru dalam dataset)

    if active_dataset:
        session_ids = get_dataset_session_ids(active_dataset['id'])
        if session_ids:
            placeholders, params = build_session_in_clause(session_ids)

            total_clean = conn.execute(
                f'SELECT COUNT(*) FROM cleaned_transaksi WHERE session_id IN ({placeholders})',
                params
            ).fetchone()[0]

            total_produk_clean = conn.execute(
                f'SELECT COUNT(DISTINCT produk) FROM cleaned_transaksi WHERE session_id IN ({placeholders})',
                params
            ).fetchone()[0]

            sales_data = conn.execute(f'''
                SELECT strftime('%Y-%m', tanggal) as bulan, SUM(jumlah) as total
                FROM cleaned_transaksi
                WHERE session_id IN ({placeholders})
                GROUP BY bulan
                ORDER BY bulan DESC
                LIMIT 6
            ''', params).fetchall()

            labels = [row['bulan'] for row in sales_data][::-1]
            values = [row['total'] for row in sales_data][::-1]

            # Ambil session terbaru dalam dataset untuk tampilan info
            active = conn.execute(
                "SELECT * FROM upload_session WHERE id=?", (session_ids[-1],)
            ).fetchone()

    # Statistik dari input manual (tabel transaksi lama)
    total_manual = conn.execute('SELECT COUNT(*) FROM transaksi').fetchone()[0]
    conn.close()

    # Agregasi cleaning stats dari seluruh session dalam dataset
    stats = None
    if active_dataset:
        session_ids = get_dataset_session_ids(active_dataset['id'])
        if session_ids:
            conn2 = get_db_connection()
            placeholders, params = build_session_in_clause(session_ids)
            rows = conn2.execute(
                f'SELECT * FROM cleaning_stats WHERE session_id IN ({placeholders})', params
            ).fetchall()
            conn2.close()
            if rows:
                stats = {
                    'total_raw': sum(safe_int(r['total_raw']) for r in rows),
                    'total_clean': sum(safe_int(r['total_clean']) for r in rows),
                    'total_batal': sum(safe_int(r['total_batal']) for r in rows),
                    'total_invalid': sum(safe_int(r['total_invalid']) for r in rows),
                    'pct_valid': round(
                        sum(safe_int(r['total_clean']) for r in rows) /
                        max(sum(safe_int(r['total_raw']) for r in rows), 1) * 100, 1
                    )
                }

    return render_template('index.html',
                           total_transaksi=total_clean,
                           total_produk=total_produk_clean,
                           total_manual=total_manual,
                           labels=labels,
                           values=values,
                           active_session=active,
                           active_dataset=active_dataset,
                           cleaning_stats=stats)


