{% extends "base.html" %}

{% block title %}Analisis Produk - Marema Textile{% endblock %}
{% block page_title %}Analisis Produk{% endblock %}
{% block page_title_mobile %}Analisis Produk{% endblock %}

{% block content %}
<div class="page-heading">
    <h4>Analisis Pola Pembelian Produk (Apriori)</h4>
    <p>Identifikasi produk yang sering dibeli bersamaan untuk mendukung strategi pengadaan dan penjualan.</p>
</div>

{% if active_session %}
<div class="alert alert-success d-flex align-items-center gap-2 mb-4 py-2 px-3" style="font-size:0.85rem;">
    <i class="bi bi-database-check"></i>
    <span><strong>Sumber Data:</strong> {{ active_session.filename }}</span>
    {% if data_stats %}
    <span class="ms-3 text-muted">{{ data_stats.total_clean }} transaksi valid</span>
    {% endif %}
    <a href="/cleaned_data" class="btn btn-sm btn-outline-success ms-auto px-3" style="font-size:0.8rem;">Lihat Data</a>
</div>
{% endif %}

<!-- Form Parameter -->
<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-sliders me-2"></i>Parameter Analisis
    </div>
    <div class="card-body">
        <form class="row g-3 align-items-end" method="GET">
            <div class="col-md-4">
                <label for="min_support" class="form-label">Minimum Support <span class="text-muted fw-normal">(0.001 – 1.0)</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-percent"></i></span>
                    <input type="number" step="0.001" min="0.001" max="1" class="form-control" name="min_support" value="{{ min_support }}" required>
                </div>
            </div>
            <div class="col-md-4">
                <label for="min_confidence" class="form-label">Minimum Confidence <span class="text-muted fw-normal">(0.01 – 1.0)</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-shield-check"></i></span>
                    <input type="number" step="0.01" min="0.01" max="1" class="form-control" name="min_confidence" value="{{ min_confidence }}" required>
                </div>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-arrow-repeat me-2"></i>Jalankan Analisis
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3">
    <!-- Frequent Itemsets -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-list-check me-2 text-info"></i>Produk yang Sering Muncul
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Produk / Kombinasi</th>
                                <th class="text-center" style="width:110px;">Support</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in frequent_itemsets %}
                            <tr>
                                <td class="ps-4">{{ item['itemsets'] }}</td>
                                <td class="text-center">
                                    <span class="badge bg-info text-white" style="font-family:monospace;">{{ "%.4f"|format(item['support']) }}</span>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="2" class="text-center py-5 text-muted" style="font-size:0.85rem;">
                                    <i class="bi bi-exclamation-triangle d-block fs-3 mb-2 text-warning"></i>
                                    Tidak ada itemset yang memenuhi nilai minimum support.
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Association Rules -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-diagram-3 me-2 text-primary"></i>Rekomendasi Restok — Pola Keterkaitan Produk
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Jika Beli &rarr; Kemungkinan juga Beli</th>
                                <th class="text-center" style="width:110px;">Confidence</th>
                                <th class="text-center" style="width:95px;">Lift</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for rule in rules %}
                            <tr>
                                <td class="ps-4">
                                    <span class="badge text-bg-primary me-1 fw-normal">{{ rule['antecedents'] }}</span>
                                    <i class="bi bi-arrow-right text-muted mx-1" style="font-size:0.75rem;"></i>
                                    <span class="badge text-bg-success fw-normal">{{ rule['consequents'] }}</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success text-white fw-bold">{{ "%.1f"|format(rule['confidence'] * 100) }}%</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-warning text-dark" style="font-family:monospace;">{{ "%.3f"|format(rule['lift']) }}</span>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted" style="font-size:0.85rem;">
                                    <i class="bi bi-exclamation-triangle d-block fs-3 mb-2 text-warning"></i>
                                    Tidak ada aturan yang terbentuk. Coba turunkan nilai Confidence atau Support.
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light border-top py-3 px-4">
                <div class="row g-2" style="font-size:0.8rem;color:#6b7280;">
                    <div class="col-md-4">
                        <strong class="text-dark">Support</strong><br>
                        Frekuensi munculnya kombinasi produk dari keseluruhan transaksi.
                    </div>
                    <div class="col-md-4">
                        <strong class="text-dark">Confidence</strong><br>
                        Tingkat kepastian bahwa jika produk A dibeli, maka B juga dibeli.
                    </div>
                    <div class="col-md-4">
                        <strong class="text-dark">Lift &gt; 1</strong><br>
                        Menunjukkan hubungan positif antar produk (saling berkaitan).
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
