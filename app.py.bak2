# ─────────────────────────────────────────────
# ROUTES — PIPELINE: UPLOAD → PREVIEW → CLEAN
# ─────────────────────────────────────────────

@app.route('/upload', methods=['GET', 'POST'])
def upload_data():
    """Step 1: Upload file mentah e-commerce."""
    if request.method == 'POST':
        if 'file' not in request.files:
            flash('Tidak ada file yang dipilih.', 'danger')
            return redirect(request.url)

        file = request.files['file']
        if file.filename == '':
            flash('Nama file kosong.', 'danger')
            return redirect(request.url)

        if not (file.filename.endswith('.csv') or file.filename.endswith('.xlsx')):
            flash('Format file tidak didukung. Gunakan .csv atau .xlsx', 'danger')
            return redirect(request.url)

        try:
            # Baca file mentah
            if file.filename.endswith('.csv'):
                # Coba beberapa encoding umum
                try:
                    df_raw = pd.read_csv(file, encoding='utf-8')
                except UnicodeDecodeError:
                    file.seek(0)
                    df_raw = pd.read_csv(file, encoding='latin-1')
            else:
                df_raw = pd.read_excel(file)

            if df_raw.empty:
                flash('File kosong atau tidak memiliki data.', 'danger')
                return redirect(request.url)

            # Deteksi mapping kolom otomatis
            mapping = detect_column_mapping(df_raw)
            validation = validate_structure(df_raw, mapping)

            # Simpan ke session upload_session
            conn = get_db_connection()
            cur = conn.execute(
                '''INSERT INTO upload_session (filename, total_rows, column_mapping, raw_preview, status)
                   VALUES (?, ?, ?, ?, ?)''',
                (
                    file.filename,
                    len(df_raw),
                    json.dumps(mapping),
                    df_raw.head(50).fillna('').to_json(orient='records', force_ascii=False),
                    'pending'
                )
            )
            session_id = cur.lastrowid

            # Simpan juga seluruh data raw (untuk proses cleaning nanti)
            # Simpan sebagai JSON di file sementara di memori (gunakan tabel raw_data)
            # Untuk data besar, kita simpan per-batch di tabel khusus
            conn.execute(
                '''CREATE TABLE IF NOT EXISTS raw_data_temp (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    session_id INTEGER,
                    row_index INTEGER,
                    row_data TEXT
                )'''
            )
            # Hapus data temp sesi lama (>5 sesi) untuk hemat storage
            conn.execute(
                '''DELETE FROM raw_data_temp WHERE session_id NOT IN (
                    SELECT id FROM upload_session ORDER BY id DESC LIMIT 5
                )'''
            )
            # Simpan data baris per baris
            rows_to_insert = [
                (session_id, idx, json.dumps(row, ensure_ascii=False, default=str))
                for idx, row in enumerate(df_raw.fillna('').to_dict('records'))
            ]
            conn.executemany(
                'INSERT INTO raw_data_temp (session_id, row_index, row_data) VALUES (?, ?, ?)',
                rows_to_insert
            )
            conn.commit()
            conn.close()

            # Simpan session_id ke flask session
            session['upload_session_id'] = session_id
            session['mapping'] = mapping
            session['validation'] = validation

            return redirect(url_for('preview_data'))

        except Exception as e:
            flash(f'Terjadi kesalahan saat membaca file: {str(e)}', 'danger')
            return redirect(request.url)

    return render_template('upload.html')


@app.route('/preview')
def preview_data():
    """Step 2: Preview data mentah + hasil mapping kolom otomatis."""
    session_id = session.get('upload_session_id')
    if not session_id:
        flash('Belum ada data yang di-upload. Silakan upload terlebih dahulu.', 'warning')
        return redirect(url_for('upload_data'))

    conn = get_db_connection()
    upload_row = conn.execute(
        'SELECT * FROM upload_session WHERE id=?', (session_id,)
    ).fetchone()

    if not upload_row:
        conn.close()
        flash('Sesi upload tidak ditemukan.', 'danger')
        return redirect(url_for('upload_data'))

    # Ambil preview data (50 baris pertama)
    preview_json = upload_row['raw_preview']
    preview_rows = json.loads(preview_json) if preview_json else []
    raw_columns = list(preview_rows[0].keys()) if preview_rows else []

    mapping = json.loads(upload_row['column_mapping']) if upload_row['column_mapping'] else {}
    conn.close()

    mapping_display = []
    label_map = {
        'id_transaksi': 'ID Transaksi',
        'tanggal': 'Tanggal',
        'produk': 'Nama Produk',
        'jumlah': 'Jumlah',
        'status': 'Status Transaksi'
    }
    required_fields = ['id_transaksi', 'tanggal', 'produk', 'jumlah', 'status']
    for target in required_fields:
        source = mapping.get(target)
        sample = ''
        if source and preview_rows:
            sample = str(preview_rows[0].get(source, ''))
            if len(sample) > 60:
                sample = sample[:60] + '...'
        mapping_display.append({
            'target': target,
            'target_label': label_map.get(target, target),
            'source': source or '—',
            'found': source is not None,
            'required': target != 'status',
            'sample': sample
        })

    # Validasi
    required_missing = [m['target_label'] for m in mapping_display if m['required'] and not m['found']]
    is_valid = len(required_missing) == 0

    return render_template('preview.html',
                           upload=upload_row,
                           preview_rows=preview_rows[:20],
                           raw_columns=raw_columns,
                           mapping_display=mapping_display,
                           is_valid=is_valid,
                           required_missing=required_missing,
                           session_id=session_id)


@app.route('/process_clean', methods=['POST'])
def process_clean():
    """Step 3: Jalankan cleaning otomatis & simpan hasilnya."""
    session_id = request.form.get('session_id', type=int)
    if not session_id:
        flash('Session tidak valid.', 'danger')
        return redirect(url_for('upload_data'))

    conn = get_db_connection()
    upload_row = conn.execute(
        'SELECT * FROM upload_session WHERE id=?', (session_id,)
    ).fetchone()

    if not upload_row:
        conn.close()
        flash('Sesi upload tidak ditemukan.', 'danger')
        return redirect(url_for('upload_data'))

    try:
        # Ambil data raw dari tabel temp
        raw_rows = conn.execute(
            'SELECT row_data FROM raw_data_temp WHERE session_id=? ORDER BY row_index ASC',
            (session_id,)
        ).fetchall()

        if not raw_rows:
            conn.close()
            flash('Data mentah tidak ditemukan. Silakan upload ulang.', 'danger')
            return redirect(url_for('upload_data'))

        records = [json.loads(r['row_data']) for r in raw_rows]
        df_raw = pd.DataFrame(records)

        # Ambil mapping (bisa ada override dari form)
        mapping = json.loads(upload_row['column_mapping'])

        # Override mapping jika pengguna mengedit di form
        for target in ['id_transaksi', 'tanggal', 'produk', 'jumlah', 'status']:
            form_val = request.form.get(f'map_{target}')
            if form_val is not None:
                mapping[target] = form_val if form_val != '__none__' else None

        # Jalankan cleaning
        df_clean, stats = clean_data(df_raw, mapping)

        if df_clean.empty:
            conn.close()
            flash(
                f'Hasil cleaning kosong! Dari {stats["total_raw"]} baris, '
                f'semua data tidak valid atau berstatus Batal. Periksa kembali file Anda.',
                'danger'
            )
            return redirect(url_for('preview_data'))

        # Hapus data cleaned lama untuk sesi ini (jika ada)
        # Sebelum delete, hapus juga dari transaksi untuk mencegah duplicate
        old_cleaned = conn.execute(
            'SELECT id_transaksi, tanggal, produk, jumlah FROM cleaned_transaksi WHERE session_id=?',
            (session_id,)
        ).fetchall()
        
        for row in old_cleaned:
            conn.execute(
                '''DELETE FROM transaksi WHERE id_transaksi=? AND tanggal=? AND produk=? AND jumlah=?''',
                (row['id_transaksi'], row['tanggal'], row['produk'], row['jumlah'])
            )
        
        conn.execute('DELETE FROM cleaned_transaksi WHERE session_id=?', (session_id,))
        conn.execute('DELETE FROM cleaning_stats WHERE session_id=?', (session_id,))

        # Simpan data bersih
        rows_clean = [
            (session_id, row['id_transaksi'], row['tanggal'], row['produk'], int(row['jumlah']))
            for _, row in df_clean.iterrows()
        ]
        conn.executemany(
            '''INSERT INTO cleaned_transaksi (session_id, id_transaksi, tanggal, produk, jumlah)
               VALUES (?, ?, ?, ?, ?)''',
            rows_clean
        )

        # DESIGN B: Juga simpan ke tabel transaksi untuk menu Transaksi
        # Data yang sama, tanpa session_id (manual+upload bercampur)
        rows_for_transaksi = [
            (row['id_transaksi'], row['tanggal'], row['produk'], int(row['jumlah']))
            for _, row in df_clean.iterrows()
        ]
        conn.executemany(
            'INSERT INTO transaksi (id_transaksi, tanggal, produk, jumlah) VALUES (?, ?, ?, ?)',
            rows_for_transaksi
        )

        # Simpan statistik
        conn.execute(
            '''INSERT INTO cleaning_stats
               (session_id, total_raw, total_clean, total_batal, total_invalid,
                cleaning_reasons, has_status_col, pct_valid)
               VALUES (?, ?, ?, ?, ?, ?, ?, ?)''',
            (
                session_id,
                stats['total_raw'],
                stats['total_clean'],
                stats['total_batal'],
                stats['total_invalid'],
                json.dumps(stats['cleaning_reasons'], ensure_ascii=False),
                1 if stats['has_status_col'] else 0,
                stats['pct_valid']
            )
        )

        # Pastikan session ini terdaftar ke dataset aktif
        dataset_id = get_or_create_active_dataset(conn)
        conn.execute(
            "UPDATE upload_session SET status='cleaned', column_mapping=?, dataset_id=? WHERE id=?",
            (json.dumps(mapping), dataset_id, session_id)
        )
        conn.commit()
        conn.close()

        flash(
            f'✅ Data cleaning selesai! {stats["total_clean"]:,} transaksi siap dianalisis '
            f'dari {stats["total_raw"]:,} data mentah.',
            'success'
        )
        return redirect(url_for('cleaned_data'))

    except Exception as e:
        conn.close()
        flash(f'Terjadi kesalahan saat proses cleaning: {str(e)}', 'danger')
        return redirect(url_for('preview_data'))


@app.route('/cleaned_data')
def cleaned_data():
    """Tampilkan hasil data cleaning + statistik + tombol aksi analisis."""
    active_dataset = get_active_dataset()
    if not active_dataset:
        flash('Belum ada data yang telah diproses. Silakan upload dan cleaning terlebih dahulu.', 'warning')
        return redirect(url_for('upload_data'))

    session_ids = get_dataset_session_ids(active_dataset['id'])
    if not session_ids:
        flash('Belum ada data yang telah diproses. Silakan upload dan cleaning terlebih dahulu.', 'warning')
        return redirect(url_for('upload_data'))

    conn = get_db_connection()
    placeholders, params = build_session_in_clause(session_ids)

    # Data tabel — seluruh transaksi dari semua session dalam dataset aktif
    transaksi = conn.execute(
        f'SELECT * FROM cleaned_transaksi WHERE session_id IN ({placeholders}) ORDER BY tanggal ASC, id ASC',
        params
    ).fetchall()

    # Agregasi statistik dari semua session
    stat_rows = conn.execute(
        f'SELECT * FROM cleaning_stats WHERE session_id IN ({placeholders})', params
    ).fetchall()

    # Produk unik dari seluruh dataset
    total_produk = conn.execute(
        f'SELECT COUNT(DISTINCT produk) FROM cleaned_transaksi WHERE session_id IN ({placeholders})',
        params
    ).fetchone()[0]

    # Session terbaru untuk tampilan nama file
    active = conn.execute(
        "SELECT * FROM upload_session WHERE id=?", (session_ids[-1],)
    ).fetchone()

    conn.close()

    # Gabungkan cleaning reasons dari semua session
    cleaning_reasons = []
    stats = None
    if stat_rows:
        all_reasons = []
        for r in stat_rows:
            if r['cleaning_reasons']:
                all_reasons.extend(json.loads(r['cleaning_reasons']))
        stats = {
            'total_raw': sum(safe_int(r['total_raw']) for r in stat_rows),
            'total_clean': sum(safe_int(r['total_clean']) for r in stat_rows),
            'total_batal': sum(safe_int(r['total_batal']) for r in stat_rows),
            'total_invalid': sum(safe_int(r['total_invalid']) for r in stat_rows),
            'pct_valid': round(
                sum(safe_int(r['total_clean']) for r in stat_rows) /
                max(sum(safe_int(r['total_raw']) for r in stat_rows), 1) * 100, 1
            )
        }
        cleaning_reasons = all_reasons

    return render_template('cleaned_data.html',
                           active_session=active,
                           active_dataset=active_dataset,
                           transaksi=transaksi,
                           stats=stats,
                           total_produk=total_produk,
                           cleaning_reasons=cleaning_reasons,
                           session_count=len(session_ids))


